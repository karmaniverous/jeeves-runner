{
  "name": "jeeves-runner-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "npm run test:scripts && npm run test --workspaces",
    "test:scripts": "node --test scripts/*.test.mjs",
    "knip": "knip",
    "docs": "typedoc",
    "typecheck": "npm run typecheck --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "knip": "^6.44.2",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.4",
    "semver": "^7.8.6",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-replace-text": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "lefthook": true
  }
}
