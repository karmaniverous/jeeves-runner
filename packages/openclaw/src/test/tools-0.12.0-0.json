{
  "definitions": [
    {
      "name": "runner_jobs",
      "description": "List all jobs with last run status",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "runner_trigger",
      "description": "Trigger manual run",
      "parameters": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "description": "The job ID."
          }
        },
        "required": [
          "jobId"
        ]
      }
    },
    {
      "name": "runner_runs",
      "description": "Run history (limit param)",
      "parameters": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "description": "The job ID."
          },
          "limit": {
            "type": "number",
            "description": "Maximum number of runs to return (default 50)."
          }
        },
        "required": [
          "jobId"
        ]
      }
    },
    {
      "name": "runner_job_detail",
      "description": "Single job detail",
      "parameters": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "description": "The job ID."
          }
        },
        "required": [
          "jobId"
        ]
      }
    },
    {
      "name": "runner_enable",
      "description": "Enable a job",
      "parameters": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "description": "The job ID."
          }
        },
        "required": [
          "jobId"
        ]
      }
    },
    {
      "name": "runner_disable",
      "description": "Disable a job",
      "parameters": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "description": "The job ID."
          }
        },
        "required": [
          "jobId"
        ]
      }
    },
    {
      "name": "runner_create_job",
      "description": "Create a new job",
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique job identifier."
          },
          "name": {
            "type": "string",
            "description": "Human-readable job name."
          },
          "schedule": {
            "type": "string",
            "description": "Cron or rrstack schedule expression."
          },
          "script": {
            "type": "string",
            "description": "Script path (source_type=path) or inline script content."
          },
          "source_type": {
            "type": "string",
            "description": "Script source: \"path\" (default) or \"inline\"."
          },
          "type": {
            "type": "string",
            "description": "Job type: \"script\" (default) or \"session\"."
          },
          "timeout_seconds": {
            "type": "number",
            "description": "Kill the job after this many seconds."
          },
          "overlap_policy": {
            "type": "string",
            "description": "\"skip\" (default) or \"allow\" concurrent runs."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the job is enabled."
          },
          "description": {
            "type": "string",
            "description": "Job description."
          },
          "on_failure": {
            "type": "string",
            "description": "Slack channel ID for failure alerts."
          },
          "on_success": {
            "type": "string",
            "description": "Slack channel ID for success alerts."
          },
          "output_channel": {
            "type": "string",
            "description": "Slack channel ID for stdout relay."
          },
          "env": {
            "type": "object",
            "description": "Environment variables for script-type jobs. Record<string, string> spread into spawn env alongside JR_* vars. Ignored for session jobs."
          },
          "args": {
            "type": "array",
            "description": "Arguments for script-type jobs. String array appended after the script path in spawn. Ignored for session jobs.",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name",
          "schedule",
          "script"
        ]
      }
    },
    {
      "name": "runner_update_job",
      "description": "Partial update of job config; omitted fields stay unchanged. Schedule changes on jeeves-scripts launcher jobs revert on the next sync-jobs (the manifest schedule is authoritative); change those in jeeves-scripts.json instead.",
      "parameters": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "description": "The job ID."
          },
          "name": {
            "type": "string",
            "description": "Human-readable job name."
          },
          "schedule": {
            "type": "string",
            "description": "Cron or rrstack schedule expression."
          },
          "script": {
            "type": "string",
            "description": "Script path (source_type=path) or inline script content."
          },
          "source_type": {
            "type": "string",
            "description": "Script source: \"path\" (default) or \"inline\"."
          },
          "type": {
            "type": "string",
            "description": "Job type: \"script\" (default) or \"session\"."
          },
          "timeout_seconds": {
            "type": "number",
            "description": "Kill the job after this many seconds."
          },
          "overlap_policy": {
            "type": "string",
            "description": "\"skip\" (default) or \"allow\" concurrent runs."
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the job is enabled."
          },
          "description": {
            "type": "string",
            "description": "Job description."
          },
          "on_failure": {
            "type": "string",
            "description": "Slack channel ID for failure alerts."
          },
          "on_success": {
            "type": "string",
            "description": "Slack channel ID for success alerts."
          },
          "output_channel": {
            "type": "string",
            "description": "Slack channel ID for stdout relay."
          },
          "env": {
            "type": "object",
            "description": "Environment variables for script-type jobs. Record<string, string> spread into spawn env alongside JR_* vars. Ignored for session jobs."
          },
          "args": {
            "type": "array",
            "description": "Arguments for script-type jobs. String array appended after the script path in spawn. Ignored for session jobs.",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "jobId"
        ]
      }
    },
    {
      "name": "runner_delete_job",
      "description": "Remove a job and its runs",
      "parameters": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "description": "The job ID."
          }
        },
        "required": [
          "jobId"
        ]
      }
    },
    {
      "name": "runner_update_script",
      "description": "Update job script (path or inline)",
      "parameters": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "description": "The job ID."
          },
          "script": {
            "type": "string",
            "description": "New script path or inline content."
          },
          "source_type": {
            "type": "string",
            "description": "Script source: \"path\" or \"inline\"."
          }
        },
        "required": [
          "jobId",
          "script"
        ]
      }
    },
    {
      "name": "runner_list_queues",
      "description": "List all queue names",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "runner_queue_status",
      "description": "Queue depth, claimed, failed, oldest age",
      "parameters": {
        "type": "object",
        "properties": {
          "queueName": {
            "type": "string",
            "description": "Queue name to inspect."
          }
        },
        "required": [
          "queueName"
        ]
      }
    },
    {
      "name": "runner_queue_peek",
      "description": "Peek at pending items (optional limit)",
      "parameters": {
        "type": "object",
        "properties": {
          "queueName": {
            "type": "string",
            "description": "Queue name to peek."
          },
          "limit": {
            "type": "number",
            "description": "Maximum items to return (default 10)."
          }
        },
        "required": [
          "queueName"
        ]
      }
    },
    {
      "name": "runner_list_namespaces",
      "description": "List all state namespaces",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "runner_query_state",
      "description": "Scalar state (optional JSONPath)",
      "parameters": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "description": "State namespace to query."
          },
          "path": {
            "type": "string",
            "description": "Optional JSONPath expression to filter results."
          }
        },
        "required": [
          "namespace"
        ]
      }
    },
    {
      "name": "runner_query_collection",
      "description": "Collection items (optional JSONPath, limit, order)",
      "parameters": {
        "type": "object",
        "properties": {
          "namespace": {
            "type": "string",
            "description": "State namespace."
          },
          "key": {
            "type": "string",
            "description": "Collection key within the namespace."
          }
        },
        "required": [
          "namespace",
          "key"
        ]
      }
    }
  ],
